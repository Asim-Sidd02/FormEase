# ---- Official-source sync ----------------------------------------------------
# Headless browser for JavaScript-only portals (Passport Seva, myAadhaar, ECI).
# Use an installed Chrome/Edge channel, or point to a Chromium binary.
FORMEASE_BROWSER_CHANNEL=chrome
# On Vercel leave both unset: there is no Chrome there, so JS-only portals report "needs browser".
# FORMEASE_BROWSER_PATH=/usr/bin/chromium

# How often a page is considered stale and re-read in the background (hours).
FORMEASE_SOURCE_TTL_HOURS=12
# Per-request timeout for official sites (ms). Some government servers are slow to connect.
FORMEASE_FETCH_TIMEOUT_MS=45000
# ---- Database (Upstash Redis) -------------------------------------------------
# Required on Vercel: Project → Storage → Upstash (Redis) → Connect. Vercel adds these automatically.
# Leave empty locally to use a JSON file in FORMEASE_DATA_DIR instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Local-only fallback storage folder.
FORMEASE_DATA_DIR=.data

# Protects POST /api/sources/sync and /api/sources/baseline. Leave empty only for local development.
FORMEASE_ADMIN_TOKEN=
# Required by GET /api/cron/sync-sources in production (sent as "Authorization: Bearer <secret>").
CRON_SECRET=

# ---- Sign-in (email one-time code) -------------------------------------------
# Random 32+ char string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# SMTP for sending codes. Free option: Gmail + an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
# Leave SMTP_USER empty in development and codes are printed in the terminal instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=node --env-file=.env scripts/migrate-snapshots.mjs
# EMAIL_FROM="FormEase <you@gmail.com>"
